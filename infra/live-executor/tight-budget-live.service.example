[Unit]
Description=Tight Budget independent LIVE observer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tightbudget
WorkingDirectory=/opt/tight-budget
EnvironmentFile=/etc/tight-budget/live.env
ExecStart=/usr/bin/node /opt/tight-budget/infra/live-executor/run.mjs --mode=daemon --state-dir=/var/lib/tight-budget-live
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
