{
  "name": "tight-budget-eod-scheduler",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "DISPATCH_ENABLED": "false" },
  "secrets": { "required": ["GITHUB_TOKEN"] },
  "triggers": {
    "crons": [
      "10,40 4-17 * * MON-FRI"
    ]
  }
}
