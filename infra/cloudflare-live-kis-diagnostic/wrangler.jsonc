  "durable_objects": { "bindings": [{ "name": "BROKER", "class_name": "KisDiagnosticBroker" }, { "name": "SHARDS", "class_name": "KisSlotShard" }] },
  "migrations": [{ "tag": "kis-diagnostic-v1", "new_sqlite_classes": ["KisDiagnosticBroker"] }, { "tag": "kis-shard-v2", "new_sqlite_classes": ["KisDiagnosticShard"] }, { "tag": "kis-slot-v3", "new_sqlite_classes": ["KisSlotShard"] }],
  "triggers": { "crons": [] }
}
